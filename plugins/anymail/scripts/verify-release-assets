#!/usr/bin/env bash
# verify-release-assets: require darwin-arm64 + win32-x64 when bin/ is present.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ ! -d "$ROOT/bin" ]; then
  echo "verify-release-assets: no bin/ (source tree); skip"
  exit 0
fi
test -f "$ROOT/bin/darwin-arm64/anymail" || {
  echo "missing darwin-arm64 anymail" >&2
  exit 1
}
test -f "$ROOT/bin/darwin-arm64/anymail.sha256" || {
  echo "missing darwin-arm64 checksum" >&2
  exit 1
}
test -f "$ROOT/bin/win32-x64/anymail.exe" || {
  echo "missing win32-x64 anymail.exe" >&2
  exit 1
}
test -f "$ROOT/bin/win32-x64/anymail.exe.sha256" || {
  echo "missing win32-x64 checksum" >&2
  exit 1
}
echo "verify-release-assets: ok"
