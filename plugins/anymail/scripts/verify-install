#!/bin/sh
# verify-install: version, checksum, and runtime-manifest agreement for this OS.
set -eu

usage() {
  printf '%s\n' 'Usage: scripts/verify-install --expected-version <version>' >&2
}
EXPECTED=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --expected-version)
      [ "$#" -ge 2 ] || {
        usage
        exit 2
      }
      EXPECTED=$2
      shift 2
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done
[ -n "$EXPECTED" ] || {
  usage
  exit 2
}

ROOT=$(CDPATH=; cd -- "$(dirname -- "$0")/.." && pwd)
FAILURES=""
add_failure() { FAILURES="$FAILURES${FAILURES:+,}\"$1\""; }

runtime="$ROOT/runtime-manifest.json"
if [ ! -f "$runtime" ]; then
  add_failure package_manifest_missing
else
  runtime_version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$runtime" | head -n 1)
  [ "$runtime_version" = "$EXPECTED" ] || add_failure runtime_manifest_version_mismatch
  source_sha=$(sed -n 's/.*"source_sha"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$runtime" | head -n 1)
  if ! printf '%s\n' "$source_sha" | grep -Eq '^[0-9a-f]{40}$'; then
    add_failure runtime_source_sha_invalid
  fi
fi

case "$(uname -s 2>/dev/null):$(uname -m 2>/dev/null)" in
  Darwin:arm64) PLATFORM=darwin-arm64 ;;
  Darwin:x86_64) PLATFORM=darwin-x64 ;;
  MINGW*:x86_64 | MINGW*:AMD64 | MSYS*:x86_64 | MSYS*:AMD64 | CYGWIN*:x86_64 | CYGWIN*:AMD64)
    PLATFORM=win32-x64
    ;;
  Windows_NT:*)
    PLATFORM=win32-x64
    ;;
  *)
    # Git Bash on Actions often reports MINGW*; also accept PROCESSOR_ARCHITECTURE.
    if [ "${OS-}" = "Windows_NT" ] || [ "${PROCESSOR_ARCHITECTURE-}" = "AMD64" ]; then
      PLATFORM=win32-x64
    else
      add_failure unsupported_platform
      PLATFORM=unknown
    fi
    ;;
esac

if [ "$PLATFORM" = win32-x64 ]; then
  ENTRYPOINT="bin/$PLATFORM/anymail.exe"
else
  ENTRYPOINT="bin/$PLATFORM/anymail"
fi
BINARY="$ROOT/$ENTRYPOINT"
CHECKSUM="$ROOT/$ENTRYPOINT.sha256"

if [ "$PLATFORM" = unknown ] || [ ! -f "$BINARY" ]; then
  add_failure native_client_missing
else
  version_output=$("$BINARY" --version 2>/dev/null || true)
  [ "$version_output" = "anymail $EXPECTED" ] || add_failure client_version_mismatch
  [ -f "$CHECKSUM" ] || add_failure checksum_missing
  if [ -f "$CHECKSUM" ]; then
    if command -v shasum >/dev/null 2>&1; then
      actual_sha=$(shasum -a 256 "$BINARY" | awk '{print $1}')
    elif command -v sha256sum >/dev/null 2>&1; then
      actual_sha=$(sha256sum "$BINARY" | awk '{print $1}')
    else
      actual_sha=""
      add_failure checksum_tool_missing
    fi
    declared_sha=$(awk 'NR == 1 {print $1}' "$CHECKSUM")
    [ -n "$actual_sha" ] && [ "$actual_sha" = "$declared_sha" ] || add_failure checksum_mismatch
  fi
  if [ -f "$runtime" ]; then
    grep -Fq "\"entrypoint\": \"$ENTRYPOINT\"" "$runtime" 2>/dev/null || add_failure runtime_platform_mismatch
  fi
  # Harmless primary action: machine JSON doctor must name this plugin.
  doctor_output=$("$BINARY" doctor 2>/dev/null || true)
  printf '%s' "$doctor_output" | grep -Fq '"plugin_id":"anymail"' \
    || printf '%s' "$doctor_output" | grep -Fq '"plugin_id": "anymail"' \
    || add_failure doctor_plugin_id_mismatch
fi

plugin_version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/.claude-plugin/plugin.json" | head -n 1)
[ "$plugin_version" = "$EXPECTED" ] || add_failure plugin_json_version_mismatch
codex_version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/.codex-plugin/plugin.json" | head -n 1)
[ "$codex_version" = "$EXPECTED" ] || add_failure codex_plugin_json_version_mismatch

if [ -n "$FAILURES" ]; then
  printf '{"ok":false,"failures":[%s]}\n' "$FAILURES" >&2
  exit 1
fi
printf '{"ok":true,"version":"%s","platform":"%s"}\n' "$EXPECTED" "$PLATFORM"
