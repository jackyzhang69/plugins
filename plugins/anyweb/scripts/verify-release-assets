#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
for platform in darwin-arm64 win32-x64; do
  name=anyweb; test "$platform" = win32-x64 && name=anyweb.exe
  binary="$ROOT/bin/$platform/$name"
  digest="$binary.sha256"
  test -f "$binary" || { echo "verify-release-assets: missing $binary" >&2; exit 1; }
  test -f "$digest" || { echo "verify-release-assets: missing $digest" >&2; exit 1; }
  expected="$(awk '{print $1}' "$digest")"
  actual="$(shasum -a 256 "$binary" | awk '{print $1}')"
  test "$expected" = "$actual" || { echo "verify-release-assets: checksum mismatch $platform" >&2; exit 1; }
done
python3 - "$ROOT/runtime-manifest.json" <<'PY'
import json, pathlib, sys
value=json.loads(pathlib.Path(sys.argv[1]).read_text())
assert value["product"] == "anyweb"
assert value["binary"]["version"] == "0.1.0"
assert set(value["binary"]["platforms"]) == {"darwin-arm64", "win32-x64"}
print("verify-release-assets: ok")
PY
