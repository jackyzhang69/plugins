#!/usr/bin/env bash
# verify-package: READ-ONLY shape + version-agreement gate for AnyCase.
#
# The marketplace clone is a published plugin subtree (runtime-manifest.json,
# host plugin.json files, skills). It does not ship Cargo.toml. When Cargo.toml
# is present, retain the stronger source-tree cross-check; otherwise the shipped
# descriptors are the package authority and must agree with each other.
#
# Confirm a published tree: copy the package (no Cargo.toml) and run this
# script. It exits 0 when runtime-manifest.json, .claude-plugin/plugin.json,
# and .codex-plugin/plugin.json share one version.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
test -f "$ROOT/skills/anycase/SKILL.md"
test ! -f "$ROOT/manifest.json"
test -f "$ROOT/.claude-plugin/plugin.json"
count="$(find "$ROOT/skills" -name SKILL.md | wc -l | tr -d ' ')"
test "$count" = "1" || { echo "verify-package: expected 1 SKILL.md, found $count" >&2; exit 1; }
python3 - "$ROOT" <<'PY'
import json, re, sys
from pathlib import Path

root = Path(sys.argv[1])
rels = (
    "runtime-manifest.json",
    ".claude-plugin/plugin.json",
    ".codex-plugin/plugin.json",
)
versions = {}
for rel in rels:
    path = root / rel
    if not path.is_file():
        sys.exit(f"verify-package: missing {rel}")
    got = json.loads(path.read_text(encoding="utf-8")).get("version")
    if not isinstance(got, str) or not got:
        sys.exit(f"verify-package: {rel} has no version")
    versions[rel] = got

ref = versions[".claude-plugin/plugin.json"]
bad = [f"{rel}={got!r}" for rel, got in versions.items() if got != ref]
if bad:
    sys.exit(f"verify-package: version disagreement against {ref!r}: {', '.join(bad)}")

cargo_path = root / "Cargo.toml"
if cargo_path.is_file():
    cargo = cargo_path.read_text(encoding="utf-8")
    match = re.search(r'(?m)^version\s*=\s*"([^"]+)"', cargo)
    if not match:
        sys.exit("verify-package: Cargo.toml has no package version")
    crate = match.group(1)
    if crate != ref:
        sys.exit(f"verify-package: crate {crate!r} != package {ref!r}")
PY
echo "verify-package: ok"
