      "command": [
        "anycase",
        "case",
        "db",
        "migrate"
      ],
      "flags": [
        "--json"
      ]
    },
    {
      "goal": "Seed the PostgreSQL case store with built-in templates and engine configuration.",
      "command": [
        "anycase",
        "case",
        "db",
        "seed"
      ],
      "flags": [
        "--json"
      ]
    },
    {
      "goal": "List cases stored in PostgreSQL.",
      "command": [
        "anycase",
        "case",
        "db",
        "list"
      ],
      "flags": [
        "--json"
      ]
    },
    {
      "goal": "Show engine targets for a template in the PostgreSQL case store.",
      "command": [
        "anycase",
        "case",
        "db",
        "targets"
      ],
      "flags": [
        "--template",
        "--json"
      ]
    },
    {
      "goal": "Print a case stored in PostgreSQL.",
      "command": [
        "anycase",
        "case",
        "db",
        "show"
      ],
      "flags": [
        "--case-id",
        "--json"
      ]
    },
    {
      "goal": "Create a PostgreSQL case from a program and template.",
      "command": [
        "anycase",
        "case",
        "db",
        "init"
      ],
      "flags": [
        "--program",
        "--template",
        "--case-id",
        "--json"
      ]
    },
    {
      "goal": "Derive a PostgreSQL case task pack and list unanswered items.",
      "command": [
        "anycase",
        "case",
        "db",
        "derive"
      ],
      "flags": [
        "--case-id",
        "--json"
      ]
    },
    {
      "goal": "Emit a PostgreSQL case task package for downstream tools.",
      "command": [
        "anycase",
        "case",
        "db",
        "plan"
      ],
      "flags": [
        "--case-id",
        "--json"
      ]
    },
    {
      "goal": "Record or merge answers in a PostgreSQL case, optionally checking its expected revision.",
      "command": [
        "anycase",
        "case",
        "db",
        "update"
      ],
      "flags": [
        "--case-id",
        "--set",
        "--intent",
        "--expect-revision",
        "--json"
      ]
    },
    {
      "goal": "Delete a PostgreSQL case and its children.",
      "command": [
        "anycase",
        "case",
        "db",
        "delete"
      ],
      "flags": [
        "--case-id",
        "--json"
      ]
