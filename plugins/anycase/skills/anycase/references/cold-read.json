      "goal": "Mark a pair-session instruction as read.",
      "command": [
        "anycase",
        "pair",
        "read"
      ],
      "flags": [
        "--message-id",
        "--json"
      ]
    },
    {
      "goal": "Send a product-status envelope in a pair session.",
      "command": [
        "anycase",
        "pair",
        "snapshot"
      ],
      "flags": [
        "--envelope-json",
        "--json"
      ]
    },
    {
