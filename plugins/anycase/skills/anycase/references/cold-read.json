{
  "schema": "jz.plugin.cold_read.v1",
  "plugin_id": "anycase",
  "version": "1.3.2",
  "capabilities": [
    {
      "goal": "Save a platform token from standard input to connect AnyCase.",
      "command": [
        "anycase",
        "login"
      ],
      "flags": [
        "--token-stdin",
        "--json"
      ]
    },
    {
      "goal": "Remove the saved local credential.",
      "command": [
        "anycase",
        "logout"
      ],
      "flags": [
        "--json"
      ]
    },
    {
      "goal": "Check masked sign-in status.",
      "command": [
        "anycase",
        "whoami"
      ],
      "flags": [
        "--json"
      ]
    },
    {
      "goal": "Check installation, sign-in, and backend, or repair the installation copy.",
      "command": [
        "anycase",
        "doctor"
      ],
      "flags": [
        "--repair-install",
        "--json"
      ]
    },
    {
      "goal": "Print the available command list.",
      "command": [
        "anycase",
        "commands"
      ],
      "flags": [
        "--json"
      ]
    },
    {
      "goal": "Send user-confirmed feedback to Jacky.",
      "command": [
        "anycase",
        "feedback"
      ],
      "flags": [
        "--type",
        "--title",
        "--description",
        "--user-confirmed",
        "--json"
      ]
    },
    {
