        "anycase",
        "caselaw"
      ],
      "flags": [
        "--court",
        "--since",
        "--until",
        "--mode",
        "--top",
        "--questions",
        "--json"
      ]
    },
    {
      "goal": "Search IRCC Help Centre question-and-answer guidance.",
      "command": [
        "anycase",
        "policy"
      ],
      "flags": [
        "--lang",
        "--mode",
        "--top",
        "--questions",
        "--json"
      ]
    },
    {
      "goal": "Search IRCC Program Delivery Instructions and operational manuals.",
      "command": [
        "anycase",
        "manual"
      ],
      "flags": [
        "--policy-code",
        "--mode",
        "--top",
        "--questions",
        "--json"
      ]
    },
    {
      "goal": "Search provincial nominee program guides, stream requirements, and points grids.",
      "command": [
        "anycase",
        "pnp"
      ],
      "flags": [
        "--province",
        "--stream",
        "--mode",
        "--top",
        "--questions",
        "--json"
      ]
    },
    {
      "goal": "Search synthesized practitioner field notes about immigration workflows.",
      "command": [
        "anycase",
        "notes"
      ],
      "flags": [
        "--top",
        "--questions",
        "--json"
      ]
    },
