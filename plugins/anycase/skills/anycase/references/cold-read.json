        "anycase",
        "documents",
        "resolve"
      ],
      "flags": [
        "--pathway-id",
        "--document-list-id",
        "--stage",
        "--channel",
        "--program-release-id",
        "--revision-id",
        "--payload-sha256",
        "--json"
      ]
    },
    {
      "goal": "Evaluate a document list against local facts for a specified date.",
      "command": [
        "anycase",
        "documents",
        "evaluate"
      ],
      "flags": [
        "--pathway-id",
        "--document-list-id",
        "--stage",
        "--channel",
        "--program-release-id",
        "--revision-id",
        "--payload-sha256",
        "--local-payload",
        "--facts",
        "--as-of",
        "--jurisdiction",
        "--locale",
        "--json"
      ]
    },
    {
      "goal": "List published scoring grids, optionally filtered by change date or revision.",
      "command": [
        "anycase",
        "score",
        "policies"
      ],
      "flags": [
        "--changed-since",
        "--json"
      ]
    },
    {
      "goal": "Show the input fields required by a scoring grid.",
      "command": [
        "anycase",
        "score",
        "inputs"
      ],
      "flags": [
        "--json"
      ]
    },
    {
      "goal": "Evaluate an applicant's inputs against a scoring grid.",
      "command": [
        "anycase",
        "score",
        "evaluate"
      ],
      "flags": [
        "--policy",
        "--inputs",
        "--as-of",
        "--resume",
        "--revision",
        "--payload-sha256",
        "--json"
      ]
    },
    {
      "goal": "Score and rank grids fully covered by the supplied inputs.",
      "command": [
        "anycase",
        "score",
        "rank"
      ],
      "flags": [
        "--inputs",
        "--as-of",
        "--json"
      ]
    },
