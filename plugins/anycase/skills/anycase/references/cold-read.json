      "command": [
        "anycase",
        "case",
        "update"
      ],
      "flags": [
        "--case-dir",
        "--set",
        "--intent",
        "--json"
      ]
    },
    {
      "goal": "Derive a local case task pack and list unanswered items.",
      "command": [
        "anycase",
        "case",
        "derive"
      ],
      "flags": [
        "--case-dir",
        "--json"
      ]
    },
    {
      "goal": "Emit a local case task package for downstream tools.",
      "command": [
        "anycase",
        "case",
        "plan"
      ],
      "flags": [
        "--case-dir",
        "--json"
      ]
    },
