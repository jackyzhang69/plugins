      "goal": "Compare two previously saved scoring results offline.",
      "command": [
        "anycase",
        "score",
        "diff"
      ],
      "flags": [
        "--json"
      ]
    },
    {
      "goal": "Create a local case file from a program and template.",
      "command": [
        "anycase",
        "case",
        "init"
      ],
      "flags": [
        "--program",
        "--template",
        "--case-id",
        "--json"
      ]
    },
    {
