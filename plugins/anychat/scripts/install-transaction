#!/usr/bin/env bash
# Install one complete verified plugin tree and expose only `current`.
set -euo pipefail

usage() {
  echo "usage: install-transaction install-tree <source-tree> <package-root> <bin-dir>" >&2
  exit 2
}

die() { echo "install-transaction: $*" >&2; exit 1; }
path_exists() { [[ -e "$1" || -L "$1" ]]; }

reject_symlink_ancestors() {
  python3 - "$1" <<'PY' || die "refusing path with a symlink ancestor: $1"
import os, pathlib, sys
p = pathlib.Path(os.path.abspath(os.path.expanduser(sys.argv[1])))
for candidate in (p, *p.parents):
    if candidate.exists() and candidate.is_symlink():
        if str(candidate) in {"/var", "/tmp", "/etc"} and candidate.lstat().st_uid == 0:
            continue
        raise SystemExit(1)
PY
}

package_version() {
  python3 - "$1/.claude-plugin/plugin.json" <<'PY'
import json, re, sys
value = json.load(open(sys.argv[1])).get("version")
if not isinstance(value, str) or not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:[-.][0-9A-Za-z]+)*", value):
    raise SystemExit(1)
print(value)
PY
}

native_platform() {
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64) echo darwin-arm64 ;;
    *) die "unsupported local development host" ;;
  esac
}

verify_tree() {
  local tree="$1" expected="$2" platform="$3"
  [[ -f "$tree/.claude-plugin/plugin.json" && ! -L "$tree/.claude-plugin/plugin.json" ]] \
    || die "staged Claude descriptor is missing or unsafe"
  [[ -f "$tree/.codex-plugin/plugin.json" && ! -L "$tree/.codex-plugin/plugin.json" ]] \
    || die "staged Codex descriptor is missing or unsafe"
  [[ -f "$tree/skills/anychat/SKILL.md" && ! -L "$tree/skills/anychat/SKILL.md" ]] \
    || die "staged AnyChat skill is missing or unsafe"
  local main="$tree/bin/$platform/anychat"
  local helper="$tree/bin/$platform/anychat-access"
  [[ -f "$main" && ! -L "$main" && -x "$main" ]] || die "staged main binary is invalid"
  [[ -f "$helper" && ! -L "$helper" && -x "$helper" ]] || die "staged helper binary is invalid"
  [[ "$(package_version "$tree")" == "$expected" ]] || die "staged package version changed"
  [[ "$("$main" --version)" == "anychat $expected" ]] || die "staged binary version does not match package"
  "$main" --help >/dev/null 2>&1 || die "staged main binary probe failed"
}

remove_path() {
  local path="$1"
  path_exists "$path" || return 0
  rm -rf -- "$path"
}

prune_version_museum() {
  local package_root="$1" entry name
  shopt -s nullglob
  for entry in "$package_root"/*; do
    name="$(basename "$entry")"
    if [[ "$name" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z]+)*$ ]]; then
      remove_path "$entry"
    fi
  done
  shopt -u nullglob
}

bind_entrypoint() {
  local target="$1" link="$2" temp
  if [[ -d "$link" && ! -L "$link" ]]; then
    die "refusing directory at host entrypoint: $link"
  fi
  temp="$link.installing.$$"
  remove_path "$temp"
  ln -s "$target" "$temp"
  mv -f "$temp" "$link"
}

install_tree() {
  local source_tree="$1" package_root="$2" bin_dir="$3"
  [[ -d "$source_tree" && ! -L "$source_tree" ]] || die "source tree is missing or unsafe"
  reject_symlink_ancestors "$package_root"
  reject_symlink_ancestors "$bin_dir"
  mkdir -p "$package_root" "$bin_dir"

  local lock="$package_root/.install-lock"
  if ! mkdir "$lock" 2>/dev/null; then
    die "another install is active; a crashed install requires host-agent inspection"
  fi

  local staging="$package_root/.staging.$$"
  local previous="$package_root/.previous.$$"
  local switched=0
  cleanup() {
    local status=$?
    remove_path "$staging"
    if [[ "$status" -ne 0 && "$switched" == 1 ]]; then
      remove_path "$package_root/current"
      if path_exists "$previous"; then mv "$previous" "$package_root/current"; fi
    fi
    remove_path "$previous"
    rmdir "$lock" 2>/dev/null || true
    exit "$status"
  }
  trap cleanup EXIT

  local version platform
  version="$(package_version "$source_tree")" || die "source package version is invalid"
  platform="$(native_platform)"
  mkdir "$staging"
  cp -R "$source_tree/." "$staging/"
  verify_tree "$staging" "$version" "$platform"

  if path_exists "$package_root/current"; then
    mv "$package_root/current" "$previous"
  fi
  mv "$staging" "$package_root/current"
  switched=1
  verify_tree "$package_root/current" "$version" "$platform"

  bind_entrypoint "$package_root/current/bin/$platform/anychat" "$bin_dir/anychat"
  bind_entrypoint "$package_root/current/bin/$platform/anychat-access" "$bin_dir/anychat-access"
  [[ "$("$bin_dir/anychat" --version)" == "anychat $version" ]] \
    || die "host entrypoint did not bind to the current package"

  remove_path "$previous"
  prune_version_museum "$package_root"
  switched=0
  rmdir "$lock"
  trap - EXIT
  echo "installed current AnyChat package $version"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  install-tree)
    [[ $# == 3 ]] || usage
    install_tree "$1" "$2" "$3"
    ;;
  *) usage ;;
esac
