#!/usr/bin/env bash
set -euo pipefail
PAIR_PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "$(uname -s)" in
  Darwin) PAIR_HOOK_BIN="$PAIR_PLUGIN_ROOT/bin/darwin-arm64/anychat" ;;
  MINGW*|MSYS*|CYGWIN*) PAIR_HOOK_BIN="$PAIR_PLUGIN_ROOT/bin/win32-x64/anychat.exe" ;;
  *) printf '{}\n'; exit 0 ;;
esac
[[ -f "$PAIR_HOOK_BIN" ]] || { printf '{}\n'; exit 0; }
exec "$PAIR_HOOK_BIN" pair host-hook
