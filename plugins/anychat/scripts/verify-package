#!/usr/bin/env bash
# verify-package: READ-ONLY consistency gate for the staged plugin package.
#
# Asserts that runtime-manifest.json, the release tag, component versions, the
# sha256 hashes, and the staged assets all agree. It FAILS on any drift and
# NEVER writes the manifest, sidecars, or binaries. It is idempotent: running it
# twice cannot change anything on disk.
#
# Allowed platforms (hard allowlist): darwin-arm64, win32-x64 only. Any other
# platform key, or a missing key, is a failure.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"   # plugin/
REPO="$(cd "$ROOT/.." && pwd)"             # repo root

MANIFEST="$ROOT/runtime-manifest.json"
test -f "$MANIFEST" || { echo "verify-package: missing runtime-manifest.json" >&2; exit 1; }
test ! -L "$MANIFEST" || { echo "verify-package: runtime-manifest.json must not be a symlink" >&2; exit 1; }

# Required skill directories (read-only existence gate). A package missing any
# of these is incomplete and must FAIL.
test -f "$ROOT/skills/anychat/SKILL.md" || { echo "verify-package: required skill missing: skills/anychat/SKILL.md" >&2; exit 1; }
test -d "$ROOT/skills/anychat/references" || { echo "verify-package: required references dir missing: skills/anychat/references" >&2; exit 1; }
skill_count="$(find "$ROOT/skills" -name SKILL.md | wc -l | tr -d ' ')"
test "$skill_count" = "1" || { echo "verify-package: expected exactly 1 SKILL.md, found $skill_count" >&2; exit 1; }

# Voice STT contract must remain present in the shipped skill text.
grep -q 'does \*\*not\*\* provide AI/STT\|does not provide AI'   "$ROOT/skills/anychat/references/media.md"   || { echo "verify-package: voice STT contract missing from skills/anychat/references/media.md" >&2; exit 1; }

PKG_VERSION="$(python3 - "$ROOT/.claude-plugin/plugin.json" <<'PY'
import json, sys
value = json.load(open(sys.argv[1])).get("version")
if not isinstance(value, str) or not value:
    raise SystemExit("verify-package: .claude-plugin/plugin.json has no version")
print(value)
PY
)"
# The public marketplace release workflow receives a plugin subtree, not this
# source checkout. When Cargo.toml is present, retain the stronger source-tree
# cross-check; otherwise the shipped descriptor is the package authority.
if [ -f "$REPO/Cargo.toml" ]; then
  CARGO_VERSION="$(cd "$REPO" && cargo metadata --format-version 1 --no-deps 2>/dev/null \
    | python3 -c 'import sys,json; print(next(p["version"] for p in json.load(sys.stdin)["packages"] if p["name"] == "anychat"))')"
  test "$PKG_VERSION" = "$CARGO_VERSION" || {
    echo "verify-package: descriptor version $PKG_VERSION != Cargo version $CARGO_VERSION" >&2
    exit 1
  }
fi
EXPECTED_TAG="anychat-v${PKG_VERSION}"

# All checks run in one Python process so partial writes are impossible and the
# script is purely read-only.
python3 - "$MANIFEST" "$ROOT" "$PKG_VERSION" "$EXPECTED_TAG" <<'PY'
import hashlib, json, pathlib, sys

manifest_path, root, pkg_version, expected_tag = sys.argv[1:5]
root = pathlib.Path(root)
m = json.loads(pathlib.Path(manifest_path).read_text())
errors = []

def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

ALLOWED = ["darwin-arm64", "win32-x64"]

# 1. Manifest schema version.
if m.get("version") != 4:
    errors.append(f"manifest.version is {m.get('version')!r}, expected 4")

# 2. Platforms allowlist: enforced globally and per component.
allowed = m.get("allowedPlatforms")
if allowed != ALLOWED:
    errors.append(f"allowedPlatforms is {allowed!r}, expected {ALLOWED!r}")

for comp in ("binary", "helper"):
    sect = m.get(comp)
    if not isinstance(sect, dict):
        errors.append(f"manifest missing '{comp}' section")
        continue
    plats = sect.get("platforms", {})
    plat_keys = sorted(plats.keys())
    if plat_keys != ALLOWED:
        errors.append(f"{comp}.platforms keys {plat_keys!r} != allowlist {ALLOWED!r}")

# 3. Component metadata: version + verifyChecksum.
for comp in ("binary", "helper"):
    sect = m.get(comp, {})
    if sect.get("version") != pkg_version:
        errors.append(
            f"{comp}.version is {sect.get('version')!r}, expected Cargo version {pkg_version!r}"
        )
    if sect.get("verifyChecksum") is not True:
        errors.append(f"{comp}.verifyChecksum must be true")

# 4. Public plugin descriptors must identify the same package version. A
# release with a fresh runtime manifest but stale host metadata is not valid.
for rel in (".codex-plugin/plugin.json", ".claude-plugin/plugin.json"):
    descriptor_path = root / rel
    try:
        if descriptor_path.is_symlink() or not descriptor_path.is_file():
            raise ValueError("descriptor is missing or a symlink")
        descriptor = json.loads(descriptor_path.read_text())
    except Exception as exc:
        errors.append(f"could not parse {rel}: {exc}")
        continue
    if descriptor.get("name") != "anychat":
        errors.append(f"{rel}.name is {descriptor.get('name')!r}, expected 'anychat'")
    if descriptor.get("version") != pkg_version:
        errors.append(
            f"{rel}.version is {descriptor.get('version')!r}, expected Cargo version {pkg_version!r}"
        )

# 5. Release tag must encode the package version.
tag = m.get("binary", {}).get("release", {}).get("tag", "")
if tag != expected_tag:
    errors.append(f"binary.release.tag is {tag!r}, expected {expected_tag!r}")

# 6. Per-platform entrypoint + sha256 + sidecar consistency (READ-ONLY).
for comp in ("binary", "helper"):
    sect = m.get(comp, {})
    for plat in ALLOWED:
        entry = sect.get("platforms", {}).get(plat, {})
        rel = entry.get("entrypoint")
        recorded = entry.get("sha256")
        if not rel or not recorded:
            errors.append(f"{comp}.{plat}: missing entrypoint or sha256")
            continue
        expected_rel = {
            ("binary", "darwin-arm64"): "bin/darwin-arm64/anychat",
            ("binary", "win32-x64"): "bin/win32-x64/anychat.exe",
            ("helper", "darwin-arm64"): "bin/darwin-arm64/anychat-access",
            ("helper", "win32-x64"): "bin/win32-x64/anychat-access.exe",
        }[(comp, plat)]
        if rel != expected_rel:
            errors.append(f"{comp}.{plat}: entrypoint {rel!r} != {expected_rel!r}")
            continue
        artifact = root / rel
        if artifact.is_symlink() or not artifact.is_file():
            errors.append(f"{comp}.{plat}: staged artifact missing or unsafe: {rel}")
            continue
        actual = sha256(artifact)
        if actual != recorded:
            errors.append(
                f"{comp}.{plat}: sha256 drift for {rel}: manifest={recorded} actual={actual}"
            )
        sidecar = artifact.parent / (artifact.name + ".sha256")
        if sidecar.is_symlink() or not sidecar.is_file():
            errors.append(f"{comp}.{plat}: sidecar missing or unsafe: {sidecar.name}")
        else:
            side_val = sidecar.read_text().strip().split()[0]
            if side_val != recorded:
                errors.append(
                    f"{comp}.{plat}: sidecar {sidecar.name}={side_val} != manifest {recorded}"
                )

# The shipped bin tree is an exact allowlist. Stale, extra, symlinked, or
# special entries must not hitchhike in a package after a profile change.
expected_bin_files = set()
for comp in ("binary", "helper"):
    for entry in m.get(comp, {}).get("platforms", {}).values():
        rel = entry.get("entrypoint")
        if rel:
            expected_bin_files.add(rel)
            expected_bin_files.add(rel + ".sha256")
bin_root = root / "bin"
actual_bin_files = set()
if bin_root.exists():
    for path in bin_root.rglob("*"):
        rel = path.relative_to(root).as_posix()
        if path.is_symlink():
            errors.append(f"unsafe symlink in bin tree: {rel}")
        elif path.is_file():
            actual_bin_files.add(rel)
        elif not path.is_dir():
            errors.append(f"unsafe special entry in bin tree: {rel}")
extra_bin = sorted(actual_bin_files - expected_bin_files)
missing_bin = sorted(expected_bin_files - actual_bin_files)
if extra_bin:
    errors.append(f"unexpected files in bin tree: {extra_bin!r}")
if missing_bin:
    errors.append(f"missing files in bin tree: {missing_bin!r}")

# 7. Version consistency for the main binary on the native host. We can only
#    execute the darwin-arm64 main binary on this Apple Silicon host; the helper
#    has no --version flag and Windows artifacts cannot run here. Their integrity
#    is pinned by sha256 (checked above) + same-checkout build (stage-package).
import subprocess
main_darwin = root / m.get("binary", {}).get("platforms", {}).get("darwin-arm64", {}).get("entrypoint", "")
if main_darwin.is_file():
    try:
        # A signed macOS binary can remain launch-suspended while the OS
        # verifies/notarization services settle. Keep this bounded but above
        # the observed two-minute delay so a valid release is not rejected.
        out = subprocess.run(
            [str(main_darwin), "--version"],
            capture_output=True, text=True, timeout=180,
        )
        if out.returncode != 0 or pkg_version not in out.stdout:
            errors.append(
                f"main binary --version did not report {pkg_version!r}: "
                f"rc={out.returncode} stdout={out.stdout!r}"
            )
    except Exception as exc:  # pragma: no cover - host-dependent
        errors.append(f"could not run main binary --version: {exc}")

if errors:
    print("verify-package: FAIL — release chain drift detected:", file=sys.stderr)
    for e in errors:
        print(f"  - {e}", file=sys.stderr)
    sys.exit(1)

print(
    f"verify-package: ok  (version {pkg_version}, tag {expected_tag}, "
    f"main + helper verified for {', '.join(ALLOWED)})"
)
PY
