#!/bin/sh
set -eu

usage() {
  printf '%s\n' 'Usage: scripts/verify-install --expected-version <version> [--loaded-skill-path <path>] [--strict-residue]' >&2
}
EXPECTED=""
LOADED=""
STRICT=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --expected-version) [ "$#" -ge 2 ] || { usage; exit 2; }; EXPECTED=$2; shift 2 ;;
    --loaded-skill-path) [ "$#" -ge 2 ] || { usage; exit 2; }; LOADED=$2; shift 2 ;;
    --strict-residue) STRICT=1; shift ;;
    --help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done
[ -n "$EXPECTED" ] || { usage; exit 2; }

ROOT=$(CDPATH=; cd -- "$(dirname -- "$0")/.." && pwd)
FAILURES=""
WARNINGS=""
add_failure() { FAILURES="$FAILURES${FAILURES:+,}\"$1\""; }
add_warning() { WARNINGS="$WARNINGS${WARNINGS:+,}\"$1\""; }

runtime="$ROOT/runtime-manifest.json"
manifest="$ROOT/manifest.json"
if [ ! -f "$runtime" ] && [ -f "$manifest" ]; then
  runtime="$manifest"
fi
if [ ! -f "$runtime" ]; then
  add_failure package_manifest_missing
else
  runtime_version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$runtime" | head -n 1)
  if [ "$runtime_version" != "$EXPECTED" ]; then
    if [ "$runtime" = "$ROOT/runtime-manifest.json" ]; then
      add_failure runtime_manifest_version_mismatch
    else
      add_failure package_manifest_version_mismatch
    fi
  fi
  if [ "$runtime" = "$ROOT/runtime-manifest.json" ]; then
    source_sha=$(sed -n 's/.*"source_sha"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$runtime" | head -n 1)
  else
    source_sha=0000000000000000000000000000000000000000
  fi
  if ! printf '%s\n' "$source_sha" | grep -Eq '^[0-9a-f]{40}$'; then
    add_failure runtime_source_sha_invalid
  fi
fi

case "$(uname -s):$(uname -m)" in
  Darwin:arm64) PLATFORM=darwin-arm64 ;;
  Darwin:x86_64) PLATFORM=darwin-x64 ;;
  Linux:x86_64) PLATFORM=linux-x64 ;;
  MINGW*:x86_64|MINGW*:amd64|MSYS*:x86_64|MSYS*:amd64|CYGWIN*:x86_64|CYGWIN*:amd64|Windows_NT:x86_64|Windows_NT:amd64) PLATFORM=windows-x64 ;;
  *) add_failure unsupported_platform; PLATFORM=unknown ;;
esac
if [ "$PLATFORM" = windows-x64 ]; then
  ENTRYPOINT="bin/$PLATFORM/anypdf.exe"
else
  ENTRYPOINT="bin/$PLATFORM/anypdf"
fi
BINARY="$ROOT/$ENTRYPOINT"
CHECKSUM="$ROOT/$ENTRYPOINT.sha256"
if [ "$PLATFORM" = unknown ] || [ ! -f "$BINARY" ]; then
  add_failure native_client_missing
else
  version_output=$($BINARY --version 2>/dev/null || true)
  [ "$version_output" = "anypdf $EXPECTED" ] || add_failure client_version_mismatch
  [ -f "$CHECKSUM" ] || add_failure checksum_missing
  if [ -f "$CHECKSUM" ]; then
    if command -v shasum >/dev/null 2>&1; then
      actual_sha=$(shasum -a 256 "$BINARY" | awk '{print $1}')
    elif command -v sha256sum >/dev/null 2>&1; then
      actual_sha=$(sha256sum "$BINARY" | awk '{print $1}')
    else
      actual_sha=""
      add_failure checksum_tool_missing
    fi
    declared_sha=$(awk 'NR == 1 {print $1}' "$CHECKSUM")
    [ -n "$actual_sha" ] && [ "$actual_sha" = "$declared_sha" ] || add_failure checksum_mismatch
  fi
  # Every PATH winner must match the packaged version. A leftover cargo or
  # host-cache binary that sorts first is an install failure.
  if command -v anypdf >/dev/null 2>&1; then
    if command -v type >/dev/null 2>&1; then
      path_bins=$(type -a -p anypdf 2>/dev/null || true)
    else
      path_bins=$(command -v anypdf 2>/dev/null || true)
    fi
    for path_bin in $path_bins; do
      [ -n "$path_bin" ] || continue
      path_ver=$("$path_bin" --version 2>/dev/null || true)
      [ "$path_ver" = "anypdf $EXPECTED" ] || add_failure path_anypdf_version_mismatch
    done
  fi
  if [ "$runtime" = "$ROOT/runtime-manifest.json" ]; then
    grep -Fq "\"entrypoint\": \"$ENTRYPOINT\"" "$runtime" 2>/dev/null || add_failure runtime_platform_mismatch
  else
    grep -Fq "\"platform\": \"$PLATFORM\"" "$runtime" 2>/dev/null || add_failure package_manifest_platform_mismatch
    grep -Fq "\"path\": \"$ENTRYPOINT\"" "$runtime" 2>/dev/null || add_failure package_manifest_binary_mismatch
  fi
fi

if command -v codex >/dev/null 2>&1; then
  installed=$(codex plugin list --json 2>/dev/null || true)
  plugin_state=$(printf '%s' "$installed" | tr '\n' ' ' | sed -E 's/},[[:space:]]*\{/}\n\{/g' | EXPECTED_VERSION="$EXPECTED" awk '
BEGIN { found = 0; matched = 0; expected = ENVIRON["EXPECTED_VERSION"] }
/"pluginId"[[:space:]]*:[[:space:]]*"anypdf@jacky-plugins"/ {
  found = 1
  if ($0 ~ ("\\\"version\\\"[[:space:]]*:[[:space:]]*\\\"" expected "\\\"")) matched = 1
}
END {
  if (matched) print "match"
  else if (found) print "mismatch"
  else print "missing"
}')
  case "$plugin_state" in
    match) : ;;
    missing|invalid) add_failure codex_plugin_not_installed ;;
    mismatch) add_failure codex_plugin_version_mismatch ;;
    *) add_failure codex_plugin_list_invalid ;;
  esac
else
  add_warning codex_plugin_list_unavailable
fi

if [ -n "$LOADED" ]; then
  case "$LOADED" in
    */anypdf/$EXPECTED/skills/*) : ;;
    *) add_failure loaded_skill_path_version_mismatch ;;
  esac
fi

for residue_root in "$HOME/.codex/.tmp/marketplaces/.staging" "$HOME/.codex/.tmp/marketplaces/.backups"; do
  if [ -d "$residue_root" ] && find "$residue_root" -mindepth 1 -maxdepth 1 -type d -name 'marketplace-upgrade-*' -print -quit | grep -q .; then
    if [ "$STRICT" -eq 1 ]; then add_failure marketplace_upgrade_residue_present; else add_warning marketplace_upgrade_residue_present; fi
  fi
done

if [ -z "$FAILURES" ]; then OK=true; else OK=false; fi
printf '{"failures":[%s],"next_actions":%s,"ok":%s,"plugin_root":"%s","warnings":[%s]}\n' "$FAILURES" '[]' "$OK" "$ROOT" "$WARNINGS"
[ "$OK" = true ]
