#!/usr/bin/env python3
"""Read-only JSON verifier for an installed AnyPDF marketplace plugin."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import subprocess
import sys


PLUGIN_ID = "anypdf@jacky-plugins"


def read_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def run(command: list[str]) -> tuple[subprocess.CompletedProcess[str] | None, str | None]:
    try:
        completed = subprocess.run(
            command,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
            timeout=60,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired) as error:
        return None, str(error)
    if completed.returncode:
        return completed, (completed.stderr or completed.stdout).strip() or f"exit {completed.returncode}"
    return completed, None


def marketplace_residue() -> list[str]:
    root = Path.home() / ".codex" / ".tmp" / "marketplaces"
    candidates = [root / ".staging", root / ".backups"]
    return [
        str(path)
        for candidate in candidates
        if candidate.exists()
        for path in candidate.glob("marketplace-upgrade-*")
        if path.is_dir()
    ]


def main() -> int:
    parser = argparse.ArgumentParser(description="Verify an AnyPDF marketplace installation.")
    parser.add_argument("--expected-version", required=True)
    parser.add_argument("--loaded-skill-path")
    parser.add_argument("--strict-residue", action="store_true")
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[1]
    failures: list[str] = []
    warnings: list[str] = []

    manifest = read_json(root / "manifest.json")
    runtime = read_json(root / "runtime-manifest.json")
    if manifest.get("version") != args.expected_version:
        failures.append("package_manifest_version_mismatch")
    if runtime.get("version") != args.expected_version:
        failures.append("runtime_manifest_version_mismatch")
    if runtime.get("platform") != "universal":
        failures.append("runtime_platform_mismatch")
    if not isinstance(runtime.get("source_sha"), str) or len(runtime["source_sha"]) != 40:
        failures.append("runtime_source_sha_invalid")

    client, client_error = run([str(root / "bin" / "anypdf"), "--version"])
    if client_error:
        failures.append("client_version_check_failed")
        warnings.append(client_error)
    elif client is not None and client.stdout.strip() != f"anypdf {args.expected_version}":
        failures.append("client_version_mismatch")

    installed, installed_error = run(["codex", "plugin", "list", "--json"])
    if installed_error:
        warnings.append(f"codex_plugin_list_unavailable:{installed_error}")
    else:
        try:
            entries = json.loads(installed.stdout).get("installed", []) if installed is not None else []
        except json.JSONDecodeError as error:
            entries = []
            warnings.append(f"codex_plugin_list_invalid:{error}")
        entry = next((item for item in entries if item.get("pluginId") == PLUGIN_ID), None)
        if not entry or entry.get("version") != args.expected_version:
            failures.append("codex_plugin_list_version_mismatch")

    if args.loaded_skill_path:
        normalized = args.loaded_skill_path.replace("\\", "/")
        if f"/anypdf/{args.expected_version}/skills/" not in normalized:
            failures.append("loaded_skill_path_version_mismatch")

    residue = marketplace_residue()
    if residue:
        if args.strict_residue:
            failures.append("marketplace_upgrade_residue_present")
        else:
            warnings.append("marketplace_upgrade_residue_present")

    result = {
        "ok": not failures,
        "failures": sorted(set(failures)),
        "next_actions": [] if not failures else ["Reinstall anypdf from jacky-plugins and rerun this verifier."],
        "plugin_root": str(root),
        "residue": residue,
        "warnings": sorted(set(warnings)),
    }
    print(json.dumps(result, sort_keys=True))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())

