#!/usr/bin/env bash
# verify-package: source/pack shape for AnyImmi.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
test -f "$ROOT/skills/anyimmi/SKILL.md"
test ! -f "$ROOT/manifest.json"
test -f "$ROOT/.claude-plugin/plugin.json"
count="$(find "$ROOT/skills" -name SKILL.md | wc -l | tr -d ' ')"
test "$count" = "1" || { echo "verify-package: expected 1 SKILL.md, found $count" >&2; exit 1; }
python3 - "$ROOT" <<'PY'
import json, re, sys
from pathlib import Path

root = Path(sys.argv[1])
cargo = (root / "Cargo.toml").read_text(encoding="utf-8")
match = re.search(r'(?m)^version\s*=\s*"([^"]+)"', cargo)
if not match:
    sys.exit("verify-package: Cargo.toml has no package version")
crate = match.group(1)
for rel in (
    "runtime-manifest.json",
    ".claude-plugin/plugin.json",
    ".codex-plugin/plugin.json",
):
    got = json.loads((root / rel).read_text(encoding="utf-8")).get("version")
    if got != crate:
        sys.exit(f"verify-package: {rel} version {got!r} != crate {crate!r}")
PY
echo "verify-package: ok"
