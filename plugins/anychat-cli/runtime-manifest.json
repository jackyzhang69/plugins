{
  "version": 3,
  "binary": {
    "name": "anychat",
    "platforms": {
      "darwin-arm64": {
        "entrypoint": "bin/darwin-arm64/anychat",
        "sha256": "6c92640e07139c515ab03d69eaef002b30cd12a70743490b51cea4f24aaa018e"
      },
      "win32-x64": {
        "entrypoint": "bin/win32-x64/anychat.exe",
        "sha256": "412f513d6adb791487dbddc56a7e3ba61e1b080164806bf58ee29bca41bddbfa"
      }
    },
    "release": {
      "host": "github-releases",
      "repo": "jackyzhang69/plugins",
      "tag": "anychat-v0.1.5"
    },
    "resolutionOrder": [
      "${platform}-${arch}"
    ],
    "fallbackBehavior": "fail",
    "verifyChecksum": true
  },
  "cacheDir": {
