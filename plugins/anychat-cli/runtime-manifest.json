{
  "version": 3,
  "binary": {
    "name": "anychat",
    "platforms": {
      "darwin-arm64": {
        "entrypoint": "bin/darwin-arm64/anychat",
        "sha256": "570bafdc0b2afc3961320ec4aaba8db2a400f05152588222e7d10765b79333e7"
      },
      "win32-x64": {
        "entrypoint": "bin/win32-x64/anychat.exe",
        "sha256": "f979f366d21633933430a0774834d3912df0201390911707b3753d321d8c3fd3"
      }
    },
    "release": {
      "host": "github-releases",
      "repo": "jackyzhang69/plugins",
      "tag": "anychat-v0.1.8"
    },
    "resolutionOrder": [
      "${platform}-${arch}"
    ],
    "fallbackBehavior": "fail",
    "verifyChecksum": true
  },
  "cacheDir": {
    "darwin": "${HOME}/.cache/anychat-cli",
    "linux": "${HOME}/.cache/anychat-cli",
    "win32": "${LOCALAPPDATA}/anychat-cli/Cache"
  },
  "configHome": {
    "darwin": "${HOME}/.jackyzhang.app/anychat",
    "linux": "${HOME}/.jackyzhang.app/anychat",
    "win32": "${USERPROFILE}/.jackyzhang.app/anychat"
  },
  "configFile": "config.json",
  "tokenEnvVar": "ANYCHAT_TOKEN",
  "defaultBaseUrl": "https://account.jackyzhang.app"
}
