    "win32": "${USERPROFILE}/.jackyzhang.app/anychat"
  },
  "configFile": "config.json",
  "tokenEnvVar": "ANYCHAT_TOKEN",
  "defaultBaseUrl": "https://account.jackyzhang.app"
}
