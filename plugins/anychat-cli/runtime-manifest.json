{
  "version": 3,
  "binary": {
    "name": "anychat",
    "platforms": {
      "darwin-arm64": {
        "entrypoint": "bin/darwin-arm64/anychat",
        "sha256": "c34ba0cbb673fcc1eca90a38cc45fdb95f8d1e297732d3724e7a81980689df82"
      },
      "win32-x64": {
        "entrypoint": "bin/win32-x64/anychat.exe",
        "sha256": "2133ab88af0b9dccb33426fe7fc7bf1ab176baf61ccd8c998c936b227d722dbe"
      }
    },
    "release": {
      "host": "github-releases",
      "repo": "jackyzhang69/plugins",
      "tag": "anychat-v0.1.6"
    },
    "resolutionOrder": [
      "${platform}-${arch}"
    ],
    "fallbackBehavior": "fail",
    "verifyChecksum": true
  },
  "cacheDir": {
