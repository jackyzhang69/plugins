{
  "version": 3,
  "binary": {
    "name": "anychat",
    "platforms": {
      "darwin-arm64": {
        "entrypoint": "bin/darwin-arm64/anychat",
        "sha256": "dd1f705be99081c33134e10b002a3a1678a488f690bcc3826621dd3a5f47dace"
      },
      "win32-x64": {
        "entrypoint": "bin/win32-x64/anychat.exe",
        "sha256": "3c2890324f90ac97fcc6fd3e8b65cfd87329ea96b0bb09d732b0af31b03c1161"
      }
    },
    "release": {
      "host": "github-releases",
      "repo": "jackyzhang69/plugins",
      "tag": "anychat-v0.1.12"
    },
    "resolutionOrder": [
      "${platform}-${arch}"
    ],
    "fallbackBehavior": "fail",
    "verifyChecksum": true
  },
  "cacheDir": {
