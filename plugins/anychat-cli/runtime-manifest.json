{
  "version": 3,
  "binary": {
    "name": "anychat",
    "platforms": {
      "darwin-arm64": {
        "entrypoint": "bin/darwin-arm64/anychat",
        "sha256": "7b119f739d55abb10125fa8ec616c71d31363ebe70a21c9b78ed4a436dc0815a"
      },
      "win32-x64": {
        "entrypoint": "bin/win32-x64/anychat.exe",
        "sha256": "a2038301b7a23245d4ad4773b69d08589fcca460657b36b74f9a2a8471e64ec9"
      }
    },
    "release": {
      "host": "github-releases",
      "repo": "jackyzhang69/plugins",
      "tag": "anychat-v0.1.10"
    },
    "resolutionOrder": [
