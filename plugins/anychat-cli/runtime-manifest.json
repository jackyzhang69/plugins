{
  "version": 3,
  "binary": {
    "name": "anychat",
    "platforms": {
      "darwin-arm64": {
        "entrypoint": "bin/darwin-arm64/anychat",
        "sha256": "4f79e79e6f90c4ba794ae2fe89033feb2129367a4f2f6de00716bdf29f857740"
      },
      "win32-x64": {
        "entrypoint": "bin/win32-x64/anychat.exe",
