{
  "version": 3,
  "binary": {
    "name": "anychat",
    "platforms": {
      "darwin-arm64": {
        "entrypoint": "bin/darwin-arm64/anychat",
        "sha256": "1dac89a4bed7057b1afd0f733edf8a48988150f6c29a726011df6059c2bba82e"
      },
      "win32-x64": {
        "entrypoint": "bin/win32-x64/anychat.exe",
        "sha256": "6be646ecc0b8550510276a383707f0f170894ae6dc9b0c6f4b782917a4b2e0d5"
      }
    },
    "release": {
      "host": "github-releases",
      "repo": "jackyzhang69/plugins",
      "tag": "anychat-v0.1.2"
    },
    "resolutionOrder": [
      "${platform}-${arch}"
    ],
    "fallbackBehavior": "fail",
    "verifyChecksum": true
  },
  "cacheDir": {
    "darwin": "${HOME}/.cache/anychat-cli",
    "linux": "${HOME}/.cache/anychat-cli",
    "win32": "${LOCALAPPDATA}/anychat-cli/Cache"
  },
  "configHome": {
    "darwin": "${HOME}/.anychat",
    "linux": "${HOME}/.anychat",
    "win32": "${USERPROFILE}/.anychat"
  },
  "configFile": "config.json",
  "tokenEnvVar": "ANYCHAT_TOKEN",
  "defaultBaseUrl": "https://account.jackyzhang.app"
}
