#!/usr/bin/env bash
# Verify staged plugin package is install-ready (darwin-arm64).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO="$(cd "$ROOT/.." && pwd)"
echo "plugin root: $ROOT"

test -f "$ROOT/runtime-manifest.json"
test -f "$ROOT/.codex-plugin/plugin.json"
test -d "$ROOT/skills/anychat-capabilities"
test -d "$ROOT/skills/connect-anychat"
test -d "$ROOT/skills/anychat-setup"
test -d "$ROOT/skills/anychat-query"
test -d "$ROOT/skills/anychat-media"
test -d "$ROOT/skills/tell-jacky"

# Voice STT contract present in skill text
grep -q 'does \*\*not\*\* provide AI/STT\|does not provide AI' \
  "$ROOT/skills/anychat-media/SKILL.md"

# Stage binary if missing (from cargo target or install-local path)
BIN_DIR="$ROOT/bin/darwin-arm64"
mkdir -p "$BIN_DIR"
BIN="$BIN_DIR/anychat"
if [[ ! -x "$BIN" ]]; then
  if [[ -x "${HOME}/.local/bin/anychat" ]]; then
    cp -f "${HOME}/.local/bin/anychat" "$BIN"
  else
    (
      cd "$REPO"
      cargo build --release
      TARGET_DIR="$(cargo metadata --format-version 1 --no-deps | python3 -c 'import sys,json; print(json.load(sys.stdin)["target_directory"])')"
      cp -f "$TARGET_DIR/release/anychat" "$BIN"
    )
  fi
  chmod +x "$BIN"
fi

"$BIN" --help >/dev/null
"$BIN" doctor --json >/dev/null || true

# Checksum sidecar
python3 - "$BIN" <<'PY'
import hashlib, pathlib, sys
p = pathlib.Path(sys.argv[1])
h = hashlib.sha256(p.read_bytes()).hexdigest()
sidecar = p.with_suffix(p.suffix + ".sha256") if p.suffix else pathlib.Path(str(p) + ".sha256")
# anychat has no suffix — write anychat.sha256
sidecar = p.parent / (p.name + ".sha256")
sidecar.write_text(h + "\n")
print("sha256", h)
PY

# Update runtime-manifest sha256
python3 - "$ROOT" <<'PY'
import hashlib, json, pathlib, sys
root = pathlib.Path(sys.argv[1])
binp = root / "bin/darwin-arm64/anychat"
h = hashlib.sha256(binp.read_bytes()).hexdigest()
mani = root / "runtime-manifest.json"
m = json.loads(mani.read_text())
m.setdefault("binary", {}).setdefault("platforms", {}).setdefault("darwin-arm64", {})["sha256"] = h
m["binary"]["platforms"]["darwin-arm64"]["entrypoint"] = "bin/darwin-arm64/anychat"
mani.write_text(json.dumps(m, indent=2) + "\n")
print("runtime-manifest updated")
PY

echo "verify-install: ok"
