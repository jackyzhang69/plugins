#!/usr/bin/env python3
"""Read-only JSON verifier for an installed FormBro marketplace plugin."""

from __future__ import annotations

import argparse
import json
import platform
import subprocess
import sys
from pathlib import Path


PLUGIN_ID = "formbro@jacky-plugins"


def read_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def run_json(command: list[str]) -> tuple[dict | None, str | None]:
    try:
        completed = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=60)
    except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
        return None, str(exc)
    if completed.returncode:
        return None, (completed.stderr or completed.stdout).strip() or f"exit {completed.returncode}"
    try:
        return json.loads(completed.stdout), None
    except json.JSONDecodeError as exc:
        return None, f"invalid JSON: {exc}"


def current_platform() -> tuple[str | None, str | None]:
    system, machine = platform.system().lower(), platform.machine().lower()
    if system == "darwin" and machine in {"arm64", "aarch64"}:
        return "darwin-arm64", "formbro"
    if system == "windows" and machine in {"amd64", "x86_64"}:
        return "win32-x64", "formbro.exe"
    return None, None


def marketplace_residue() -> list[str]:
    root = Path.home() / ".codex" / ".tmp" / "marketplaces"
    candidates = [root / ".staging", root / ".backups"]
    return [str(path) for candidate in candidates if candidate.exists() for path in candidate.glob("marketplace-upgrade-*") if path.is_dir()]


def main() -> int:
    parser = argparse.ArgumentParser(description="Verify a FormBro marketplace plugin installation.")
    parser.add_argument("--expected-version", required=True)
    parser.add_argument("--expected-binary-version", required=True)
    parser.add_argument("--loaded-skill-path")
    parser.add_argument("--strict-residue", action="store_true")
    args = parser.parse_args()

    root = Path(__file__).resolve().parents[1]
    plugin = read_json(root / ".codex-plugin" / "plugin.json")
    runtime = read_json(root / "runtime-manifest.json")
    failures: list[str] = []
    warnings: list[str] = []

    if plugin.get("version") != args.expected_version:
        failures.append("plugin_manifest_version_mismatch")
    release_tag = runtime.get("binary", {}).get("release", {}).get("tag")
    if release_tag != f"plugin-v{args.expected_version}":
        failures.append("runtime_release_tag_mismatch")
    platforms = runtime.get("binary", {}).get("platforms", {})
    if set(platforms) != {"darwin-arm64", "win32-x64"}:
        failures.append("runtime_platform_set_mismatch")
    if "pdf" in json.dumps(runtime).lower():
        failures.append("runtime_declares_pdf_component")
    for name, config in platforms.items():
        lazy = config.get("lazy", [])
        if len(lazy) != 1 or not isinstance(lazy[0].get("sha256"), str) or len(lazy[0]["sha256"]) != 64:
            failures.append(f"runtime_lazy_asset_invalid:{name}")

    installed, installed_error = run_json(["codex", "plugin", "list", "--json"])
    entry = next((item for item in (installed or {}).get("installed", []) if item.get("pluginId") == PLUGIN_ID), None)
    if installed_error:
        warnings.append(f"codex_plugin_list_unavailable:{installed_error}")
    elif not entry or entry.get("version") != args.expected_version:
        failures.append("codex_plugin_list_version_mismatch")

    if args.loaded_skill_path and f"/formbro/{args.expected_version}/skills/" not in args.loaded_skill_path.replace("\\", "/"):
        failures.append("loaded_skill_path_version_mismatch")

    platform_name, binary_name = current_platform()
    if not platform_name:
        warnings.append("host_platform_not_bundled")
    else:
        binary = root / "bin" / platform_name / binary_name
        if not binary.exists():
            failures.append("bundled_binary_missing")
        else:
            doctor, error = run_json([str(binary), "doctor", "--json", "--no-fetch"])
            if error:
                failures.append("doctor_failed")
                warnings.append(error)
            elif doctor and doctor.get("binary_version") != args.expected_binary_version:
                failures.append("doctor_binary_version_mismatch")

    residue = marketplace_residue()
    if residue:
        if args.strict_residue:
            failures.append("marketplace_upgrade_residue_present")
        else:
            warnings.append("marketplace_upgrade_residue_present")

    result = {
        "ok": not failures,
        "failures": sorted(set(failures)),
        "next_actions": [] if not failures else ["Reinstall formbro from jacky-plugins and rerun this verifier."],
        "plugin_root": str(root),
        "residue": residue,
        "warnings": sorted(set(warnings)),
    }
    print(json.dumps(result, sort_keys=True))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
