#!/usr/bin/env bash
# verify-package: read-only shape gate for a packed formbro-cli tree.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# When run from source, plugin-metadata is the metadata root; when packed,
# this script lives at scripts/ next to skills/.
if [ -d "$ROOT/plugin-metadata" ]; then
  META="$ROOT/plugin-metadata"
  SKILLS="$ROOT/.agents/skills"
else
  META="$ROOT"
  SKILLS="$ROOT/skills"
fi
test -f "$META/runtime-manifest.json"
test -f "$SKILLS/formbro/SKILL.md" || { echo "verify-package: missing skills/formbro/SKILL.md" >&2; exit 1; }
count="$(find "$SKILLS" -name SKILL.md | wc -l | tr -d ' ')"
# Source tree may also contain developer-only formbro-pdf-local/SKILL.md.
if [ -d "$ROOT/plugin-metadata" ]; then
  test -f "$ROOT/.agents/skills/formbro-pdf-local/SKILL.md"
else
  test "$count" = "1" || { echo "verify-package: packed tree must have exactly 1 SKILL.md, found $count" >&2; exit 1; }
fi

# DeepSeek Harness bundle layer (delivery/plugin-policy.md required host surface).
for f in package.json cordis.patch.yml index.js; do
  test -f "$META/$f" || { echo "verify-package: missing DeepSeek Harness bundle file $f" >&2; exit 1; }
done
python3 - "$META/package.json" "$META/runtime-manifest.json" <<'PY'
import json, pathlib, sys
pkg = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
bad = []
if pkg.get("name") != "dsh-formbro":
    bad.append(f"package.json name={pkg.get('name')!r} (expected 'dsh-formbro')")
if ((pkg.get("dsh") or {}).get("bundle") or {}).get("patch") != "./cordis.patch.yml":
    bad.append("package.json.dsh.bundle.patch must be './cordis.patch.yml'")
# Source mode: release tag is the CI placeholder; packed: tag pins the version.
tag = (
    json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))
    .get("binary", {})
    .get("release", {})
    .get("tag", "")
)
if tag.startswith("plugin-v") and pkg.get("version") != tag[len("plugin-v"):]:
    bad.append(f"package.json version={pkg.get('version')!r} disagrees with release tag {tag!r}")
if bad:
    sys.exit("verify-package: " + "; ".join(bad))
PY
echo "verify-package: ok"
