{
  "$schema": "https://formbro.ca/schemas/runtime-manifest-v3.json",
  "version": 3,
  "binary": {
    "name": "formbro",
    "platforms": {
      "darwin-arm64": {
        "entrypoint": "bin/darwin-arm64/formbro",
        "lazy": [
          {
            "name": "webform-worker",
            "asset": "webform-worker-darwin-arm64.tar.gz",
            "archive": "tar.gz",
            "sha256": "585e2401bb99efd97edb450a43bb33fc970df1d60105281a27d7de1d5cb70362"
          }
        ]
      },
      "win32-x64": {
        "entrypoint": "bin/win32-x64/formbro.exe",
        "lazy": [
          {
            "name": "webform-worker.exe",
            "asset": "webform-worker-win32-x64.zip",
            "archive": "zip",
            "sha256": "8538effa38046981ce9b19a47b65e10560b31f342b0eeb66c588ed5545cdcf69"
          }
        ]
      },
      "linux-x64": {
        "entrypoint": "bin/linux-x64/formbro",
        "lazy": [
          {
            "name": "webform-worker",
            "asset": "webform-worker-linux-x64.tar.gz",
            "archive": "tar.gz",
            "sha256": "3e2cb6f14ca43c7b0e7d3851ac2628d6eb378083cef254d8a976dbeb952ac72f"
          }
        ]
      }
    },
    "release": {
      "host": "github-releases",
      "repo": "jackyzhang69/plugins",
      "tag": "plugin-v1.9.6"
    },
    "resolutionOrder": [
      "${platform}-${arch}"
    ],
    "fallbackBehavior": "fail",
    "verifyChecksum": true
  },
  "cacheDir": {
    "darwin": "${HOME}/.cache/formbro-cli",
    "linux": "${HOME}/.cache/formbro-cli",
    "win32": "${LOCALAPPDATA}/formbro-cli/Cache"
  },
  "configHome": {
    "darwin": "${HOME}/.formbro",
    "linux": "${HOME}/.formbro",
    "win32": "${USERPROFILE}/.formbro"
  },
  "configFile": "config.json",
  "tokenEnvVar": "FORMBRO_API_TOKEN",
  "defaultBaseUrl": "https://formbro-api.jackyzhang.app",
  "source_sha": "1cb354f6574f116cbf67a6886cd72ecf3fade5f3"
}
