{
  "$schema": "https://formbro.ca/schemas/runtime-manifest-v3.json",
  "version": 3,
  "binary": {
    "name": "formbro",
    "platforms": {
      "darwin-arm64": {
        "entrypoint": "bin/darwin-arm64/formbro",
        "lazy": [
          {
            "name": "webform-worker",
            "asset": "webform-worker-darwin-arm64.tar.gz",
            "archive": "tar.gz",
            "sha256": "a58aaff07f5f1740492d87002401830eb430914413e9151c27c4092abee89543"
          }
        ]
      },
      "win32-x64": {
        "entrypoint": "bin/win32-x64/formbro.exe",
        "lazy": [
          {
            "name": "webform-worker.exe",
            "asset": "webform-worker-win32-x64.zip",
            "archive": "zip",
            "sha256": "f821a2e8c79252867d910dbac7c6f3c49ce21e376a9bed706fa56baf469d5955"
          }
        ]
      }
    },
    "release": {
      "host": "github-releases",
      "repo": "jackyzhang69/plugins",
      "tag": "plugin-v1.9.1"
    },
    "resolutionOrder": [
      "${platform}-${arch}"
    ],
    "fallbackBehavior": "fail",
    "verifyChecksum": true
  },
  "cacheDir": {
    "darwin": "${HOME}/.cache/formbro-cli",
    "linux": "${HOME}/.cache/formbro-cli",
    "win32": "${LOCALAPPDATA}/formbro-cli/Cache"
  },
  "configHome": {
    "darwin": "${HOME}/.formbro",
    "linux": "${HOME}/.formbro",
    "win32": "${USERPROFILE}/.formbro"
  },
  "configFile": "config.json",
  "tokenEnvVar": "FORMBRO_API_TOKEN",
  "defaultBaseUrl": "https://formbro-api.jackyzhang.app",
  "source_sha": "8fc54cdb10a833dd6f65365443cbfea25accc890"
}
